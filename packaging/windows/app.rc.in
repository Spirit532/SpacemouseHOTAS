#include <windows.h>

@WINDOWS_ICON_LINE@

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "SpacemouseHOTAS"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "SpacemouseHOTAS"
            VALUE "OriginalFilename", "SpacemouseHOTAS.exe"
            VALUE "ProductName", "SpacemouseHOTAS"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
